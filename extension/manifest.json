{
  "manifest_version": 3,
  "name": "Lyrics & Vocab Companion (dev)",
  "version": "0.10.0",
  "description": "Synced lyrics on YouTube Music — tap words to translate, save, and review them anywhere.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "vocab.html",
    "default_title": "Your words"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["config.js", "lyricsProvider.js", "meaningProvider.js", "syncProvider.js", "settingsStore.js", "offsetStore.js", "vocabStore.js", "panel.js", "wordPopup.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["mediaSessionBridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
